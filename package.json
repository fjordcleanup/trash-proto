{
  "name": "@fjordcleanup/trash-proto",
  "version": "0.0.0-development",
  "description": "Protocol definitions for the application.",
  "homepage": "https://github.com/fjordcleanup/trash-proto#readme",
  "bugs": {
    "url": "https://github.com/fjordcleanup/trash-proto/issues"
  },
  "license": "MIT",
  "author": "Markus Tacker <m@coderbyheart.com> | https://coderbyheart.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjordcleanup/trash-proto.git"
  },
  "files": [
    "npm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./npm/exports.d.ts",
        "default": "./npm/exports.js"
      }
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "node --no-warnings --test \"!(node_modules)/**/*.spec.ts\"",
    "test:watch": "node --no-warnings --test --watch \"!(node_modules)/**/*.spec.ts\"",
    "prepare": "husky",
    "prepublishOnly": "node ./.npm/compile.ts && npx tsc -P ./.npm/tsconfig.npm.json --outDir ./npm"
  },
  "dependencies": {
    "@coderbyheart/aws-dynamodb-es-cqrs": "^1.3.1",
    "@sinclair/typebox": "^0.34.52",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "commitlint": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "oxfmt": "0.79.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt --write"
    ],
    "*.{md,json,yaml,yml}": [
      "oxfmt --write"
    ]
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failCommentCondition": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">= 12.2.2 <13"
  }
}
